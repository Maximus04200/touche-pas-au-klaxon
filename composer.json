{
    "name": "local/touche-pas-au-klaxon",
    "type": "project",
    "authors": [
        {
            "name": "dev",
            "email": "martinlestoppeur@gmail.com"
        }
    ],
    "require": {
        "bramus/router": "^1.6",
        "vlucas/phpdotenv": "^5.6"
    },
    "require-dev": {
        "phpunit/phpunit": "^11",
        "phpstan/phpstan": "^2"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "stan": "phpstan analyse",
        "check": ["@stan", "@test"]
    },
    "config": {
        "sort-packages": true
    }
}
